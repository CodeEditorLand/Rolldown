digraph G {
  newrank=true;
  rankdir=LR;
  splines=ortho;
  overlap=false;
  nodesep=0.5;
  ranksep=0.5;
  concentrate=true;
  graph [bgcolor="#f9f9f9", color="#888888", penwidth=2, fontname="Arial"];
  node [fontname="Arial", fontsize=14, style=filled, margin="0.3,0.2"];
  edge [fontname="Arial", fontsize=10, color="#555555", fontcolor="gray"];
  subgraph cluster_1 {
    label="root";
    style=filled; color="#5DADE2"; fillcolor="#5DADE220";
    "n0" [label="root", shape=folder, fillcolor="#5DADE2", penwidth=1.5];
    "n7" [label="npm (.): monorepo v0.0.1", shape=ellipse, fillcolor="#F4D03F", penwidth=1.5];
  subgraph cluster_2 {
    label="scripts";
    style=filled; color="#3498DB"; fillcolor="#3498DB20";
    "n4" [label="scripts", shape=folder, fillcolor="#3498DB", penwidth=1.5];
    "n8" [label="npm (./scripts): @codeeditorland-internal/scripts v0.0.1", shape=ellipse, fillcolor="#F4D03F", penwidth=1.5];
    "n5" [label="package.json", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

    "n3" [label="package.json", shape=note, fillcolor="#FADBD8", penwidth=1];
  subgraph cluster_3 {
    label="docs";
    style=filled; color="#3498DB"; fillcolor="#3498DB20";
    "n1" [label="docs", shape=folder, fillcolor="#3498DB", penwidth=1.5];
    "n6" [label="npm (./docs): @codeeditorland/docs v0.0.1", shape=ellipse, fillcolor="#F4D03F", penwidth=1.5];
    "n2" [label="package.json", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

  }

  "n0" -> "n1" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n1" -> "n2" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n3" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n4" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n4" -> "n5" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n1" -> "n6" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n7" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n4" -> "n8" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  subgraph cluster_legend {
    label="Legend"; fontsize=14; style=dashed; color=gray;
    "dir" [label="Directory", shape=folder, fillcolor="#5DADE2"];
    "file" [label="File", shape=note, fillcolor="#FADBD8"];
    "pkg" [label="Package", shape=ellipse, fillcolor="#EB984E"];
    "ext" [label="External", shape=trapezium, fillcolor="#EC7063"];
    "dir" -> "file" [label="Contain", style=solid, color=blue];
    "pkg" -> "ext" [label="Dependency", style=dashed, color=red];
  }
}
