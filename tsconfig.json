{
	"$comment": "The config is for pure Js projects, which are executed by Node.js directly.",
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"baseUrl": "./",
		"declaration": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedDeclarations": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"outDir": "Target",
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": [
			"node"
		]
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src",
		"src",
		"src",
		"src",
		"src"
	],
	"references": [
		{
			"path": "./packages/bench"
		},
		{
			"path": "./packages/rolldown"
		},
		{
			"path": "./packages/rolldown/tests"
		},
		{
			"path": "./packages/rollup-tests"
		},
		{
			"path": "./packages/testing"
		},
		{
			"path": "./packages/test-dev-server"
		}
	]
}
