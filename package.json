{
	"name": "monorepo",
	"version": "0.0.1",
	"private": false,
	"description": "Rollup in Rust",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Rolldown#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Rolldown/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Rolldown.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"scripts": {
		"build": "echo \"Use just build\"",
		"build:release": "echo \"Use just build native release\"",
		"changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
		"ci:build-release-binding": "pnpm --filter rolldown run build-binding:release",
		"docs": "pnpm --filter rolldown-docs run dev",
		"docs:build": "pnpm --filter rolldown-docs run build",
		"docs:preview": "pnpm --filter rolldown-docs run preview",
		"preinstall": "npx only-allow pnpm",
		"lint-code": "oxlint -c .oxlintrc.json --ignore-path=.oxlintignore --deny-warnings",
		"lint-repo": "pnpm run --stream --color \"/^fmt|lint-spell$/\"",
		"lint-spell": "cspell \"**\" --no-progress  --gitignore",
		"prepare": "husky prepare",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"type-check": "tsc -b tsconfig.json"
	},
	"lint-staged": {
		"*": "cspell --no-progress --gitignore --no-must-find-files",
		"*.@(js|ts|tsx)": [
			"pnpm lint-code -- --fix"
		],
		"*.@(js|ts|tsx|yml|yaml|md|json|html|toml)": [
			"dprint fmt"
		]
	},
	"dependencies": {},
	"devDependencies": {
		"@actions/core": "1.11.1",
		"@codeeditorland-node/core": "0.0.22",
		"@codeeditorland-project/runtime": "0.63.0",
		"@playform/build": "0.2.3",
		"@types/node": "22.14.1",
		"cjs-module-lexer": "2.1.0",
		"conventional-changelog-cli": "5.0.0",
		"cross-env": "7.0.3",
		"cspell": "8.19.0",
		"dprint": "0.49.1",
		"lint-staged": "15.5.1",
		"oxlint": "0.16.6",
		"rolldown": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
