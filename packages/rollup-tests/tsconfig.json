{
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": "./",
		"checkJs": true,
		"composite": true,
		"esModuleInterop": true,
		"isolatedDeclarations": false,
		"module": "CommonJS",
		"moduleResolution": "Node",
		"outDir": "Target",
		"resolveJsonModule": true,
		"rootDir": "src",
		"types": [
			"mocha",
			"node"
		]
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src/**/*.js",
		"src",
		"src",
		"src",
		"src",
		"src",
		"src"
	]
}
