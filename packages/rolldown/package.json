{
	"name": "rolldown",
	"version": "0.0.1",
	"private": false,
	"description": "Fast JavaScript/TypeScript bundler in Rust with Rollup-compatible API.",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/Rolldown#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/Rolldown/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/Rolldown.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"imports": {
		"#parallel-plugin-worker": "./dist/parallel-plugin-worker.mjs"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/types/index.d.ts"
		},
		"./experimental": {
			"import": "./dist/experimental-index.mjs",
			"require": "./dist/experimental-index.cjs",
			"types": "./dist/types/experimental-index.d.ts"
		},
		"./package.json": "./package.json",
		"./parallel-plugin": {
			"import": "./dist/parallel-plugin.mjs",
			"require": "./dist/parallel-plugin.cjs",
			"types": "./dist/types/parallel-plugin.d.ts"
		},
		"./parseAst": {
			"import": "./dist/parse-ast-index.mjs",
			"require": "./dist/parse-ast-index.cjs",
			"types": "./dist/types/parse-ast-index.d.ts"
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/types/index.d.ts",
	"bin": {
		"rolldown": "./bin/cli.mjs"
	},
	"files": [
		"bin",
		"cli",
		"dist",
		"!dist/*.node"
	],
	"scripts": {
		"# Scrips for binding #": "_",
		"# Scrips for docs #": "_",
		"# Scrips for node #": "_",
		"artifacts": "napi artifacts --cwd ./src --package-json-path ../package.json -o=../artifacts --npm-dir ../npm",
		"build-binding": "tsx ./build-binding.mts",
		"build-binding:release": "pnpm build-binding --release",
		"build-binding:wasi": "pnpm build-binding --target wasm32-wasip1-threads",
		"build-binding:wasi:release": "pnpm build-binding --profile release-wasi --target wasm32-wasip1-threads",
		"build-js-glue": "pnpm run --sequential \"/^build-(types|node|types-check)$/\"",
		"build-native:debug": "pnpm run --sequential \"/^build-(binding|js-glue)$/\"",
		"build-native:release": "pnpm run --sequential \"/^build-(binding:release|js-glue)$/\"",
		"build-node": "tsx ./build.ts",
		"build-types": "tsc -p ./tsconfig.json",
		"build-types-check": "tsc -p ./tsconfig.check.json",
		"build-wasi:debug": "pnpm run --sequential \"/^build-(binding|binding:wasi|node)$/\"",
		"build-wasi:release": "pnpm run --sequential \"/^build-(binding|binding:wasi:release|node)$/\"",
		"extract-options-doc": "typedoc",
		"preinstall": "npx only-allow pnpm",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"dependencies": {
		"@codeeditorland-project/types": "0.63.0",
		"@valibot/to-json-schema": "1.0.0",
		"valibot": "1.0.0"
	},
	"devDependencies": {
		"@codeeditorland-node/core": "0.0.22",
		"@codeeditorland/parser": "0.63.0",
		"@codeeditorland/testing": "workspace:*",
		"@jridgewell/sourcemap-codec": "1.5.0",
		"@napi-rs/cli": "3.0.0-alpha.74",
		"@napi-rs/wasm-runtime": "0.2.9",
		"@playform/build": "0.2.3",
		"@types/fs-extra": "11.0.4",
		"@types/lodash-es": "4.17.12",
		"colorette": "2.0.20",
		"consola": "3.4.2",
		"emnapi": "1.4.3",
		"execa": "9.5.2",
		"fs-extra": "11.3.0",
		"glob": "11.0.1",
		"locate-character": "3.0.0",
		"remeda": "2.21.3",
		"rolldown": "workspace:*",
		"signal-exit": "4.1.0",
		"source-map": "0.7.4",
		"tsx": "4.19.3",
		"type-fest": "4.40.0",
		"typedoc": "0.28.3",
		"unbuild": "3.5.0",
		"why-is-node-running": "3.2.2"
	},
	"peerDependenciesMeta": {
		"@oxc-project/runtime": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"@rolldown/binding-darwin-arm64": "workspace:*",
		"@rolldown/binding-darwin-x64": "workspace:*",
		"@rolldown/binding-freebsd-x64": "workspace:*",
		"@rolldown/binding-linux-arm-gnueabihf": "workspace:*",
		"@rolldown/binding-linux-arm64-gnu": "workspace:*",
		"@rolldown/binding-linux-arm64-musl": "workspace:*",
		"@rolldown/binding-linux-x64-gnu": "workspace:*",
		"@rolldown/binding-linux-x64-musl": "workspace:*",
		"@rolldown/binding-wasm32-wasi": "workspace:*",
		"@rolldown/binding-win32-arm64-msvc": "workspace:*",
		"@rolldown/binding-win32-ia32-msvc": "workspace:*",
		"@rolldown/binding-win32-x64-msvc": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	},
	"napi": {
		"binaryName": "rolldown-binding",
		"dtsHeader": "type MaybePromise<T> = T | Promise<T>\ntype Nullable<T> = T | null | undefined\ntype VoidNullable<T = void> = T | null | undefined | void\nexport type BindingStringOrRegex = string | RegExp\n\n",
		"packageName": "@rolldown/binding",
		"targets": [
			"x86_64-apple-darwin",
			"x86_64-pc-windows-msvc",
			"x86_64-unknown-linux-gnu",
			"x86_64-unknown-linux-musl",
			"x86_64-unknown-freebsd",
			"i686-pc-windows-msvc",
			"armv7-unknown-linux-gnueabihf",
			"aarch64-unknown-linux-gnu",
			"aarch64-apple-darwin",
			"aarch64-unknown-linux-musl",
			"aarch64-pc-windows-msvc",
			"wasm32-wasip1-threads"
		],
		"wasm": {
			"browser": {
				"fs": true
			},
			"initialMemory": 16384
		}
	}
}
