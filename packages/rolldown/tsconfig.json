{
	"compilerOptions": {
		"baseUrl": "./",
		"composite": true,
		"noEmit": false,
		"outDir": "Target",
		"resolveJsonModule": true,
		"rootDir": "src",
		"tsBuildInfoFile": ".tsbuildinfo"
	},
	"exclude": [
		"*.js",
		"*.mjs",
		"*.cjs",
		"dist",
		"lib"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"./src/**/*",
		"src"
	]
}
