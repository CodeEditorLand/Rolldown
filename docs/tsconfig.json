{
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": "./",
		"esModuleInterop": true,
		"jsx": "preserve",
		"module": "esnext",
		"moduleResolution": "bundler",
		"noUnusedLocals": true,
		"outDir": "Target",
		"paths": {
			"@theme/*": [
				".vitepress/theme/*"
			]
		},
		"resolveJsonModule": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"env.d.ts",
		"src/**/*",
		".vitepress/**/*",
		"src"
	]
}
